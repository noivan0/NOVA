# ── LLM Provider ───────────────────────────────────────────────────────────
# Required: set ONE of these

# OpenAI
NOVA_LLM_PROVIDER=openai
NOVA_LLM_MODEL=gpt-4o
NOVA_LLM_API_KEY=***

# Anthropic Claude (alternative)
# NOVA_LLM_PROVIDER=anthropic
# NOVA_LLM_MODEL=claude-sonnet-4-6
# NOVA_LLM_API_KEY=***

# Ollama local (alternative — no API key needed)
# NOVA_LLM_PROVIDER=ollama
# NOVA_LLM_MODEL=llama3.3
# NOVA_LLM_BASE_URL=http://localhost:11434

# Custom OpenAI-compatible endpoint (enterprise / self-hosted)
# NOVA_LLM_PROVIDER=custom
# NOVA_LLM_MODEL=my-model-name
# NOVA_LLM_BASE_URL=https://my-gateway.example.com/v1
# NOVA_LLM_API_KEY=***

# ── Notifier (optional) ────────────────────────────────────────────────────
# Leave NOVA_NOTIFIER_PROVIDER=none to disable notifications

# Telegram
# NOVA_NOTIFIER_PROVIDER=telegram
# NOVA_NOTIFIER_TOKEN=123456...D...
# NOVA_NOTIFIER_CHAT_ID=-1001234567890

# Slack
# NOVA_NOTIFIER_PROVIDER=slack
# NOVA_NOTIFIER_WEBHOOK_URL=https://hooks.slack.com/services/...

# Discord
# NOVA_NOTIFIER_PROVIDER=discord
# NOVA_NOTIFIER_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ── Publisher (optional) ───────────────────────────────────────────────────
# Default: file — writes output to ./output/

# WordPress
# NOVA_PUBLISHER_PROVIDER=wordpress
# NOVA_PUBLISHER_BASE_URL=https://myblog.com
# NOVA_PUBLISHER_API_KEY=myuser:app_password

# Ghost
# NOVA_PUBLISHER_PROVIDER=ghost
# NOVA_PUBLISHER_BASE_URL=https://myblog.ghost.io
# NOVA_PUBLISHER_API_KEY=id:hex_secret

# ── Paths (optional overrides) ─────────────────────────────────────────────
# NOVA_WORKSPACE=./workspace
# NOVA_KB_PATH=./kb
# NOVA_HARNESSES_DIR=./harnesses
